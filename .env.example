# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# --- LLM (generation) ---
RAG_GEMINI_API_KEY=your-key-here
RAG_GEMINI_MODEL=gemini-2.5-flash-lite
RAG_JUDGE_MODEL=gemini-2.5-flash

# --- Embeddings (retrieval) ---
# local  = offline all-MiniLM-L6-v2 (no quota), gemini = gemini-embedding-001
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=gemini-embedding-001

# --- Vector store ---
RAG_VECTORSTORE=chroma
RAG_CHROMA_DIR=data/chroma
RAG_COLLECTION=system_design

# --- Retrieval ---
RAG_TOP_K=6
RAG_CANDIDATE_MULTIPLIER=5
RAG_DUP_COSINE_THRESHOLD=0.92
RAG_MAX_PER_SOURCE=2

# --- Service ---
RAG_API_KEY=                 # optional: if set, clients must send X-API-Key
RAG_LOG_LEVEL=INFO
RAG_ENABLE_GUARDRAILS=true
